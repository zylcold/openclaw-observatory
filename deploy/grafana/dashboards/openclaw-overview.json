          "legendFormat": "Read {{instance}}"
        },
        {
          "refId": "B",
          "expr": "rate(openclaw_process_write_bytes_total{instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "Write {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Disk Free",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * openclaw_host_disk_available_bytes{instance=~\"$instance\"} / clamp_min(openclaw_host_disk_total_bytes{instance=~\"$instance\"}, 1)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      }
    },
